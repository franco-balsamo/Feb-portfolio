---
import type { projects as ProjectsType } from '../data/portfolio';

interface Props {
  projects: typeof ProjectsType;
}

const { projects } = Astro.props;
const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="proyectos">
  <div class="container">
    <div class="section-header">
      <p class="section-label">02 / Trabajo</p>
      <h2 class="section-title section-heading">Proyectos</h2>
    </div>

    <!-- featured: first one full-width editorial, rest side by side -->
    {featured.length > 0 && (
      <div class="featured-list">
        {featured.map((p, i) => (
          <article class={`featured-card ${i === 0 ? 'featured-card--hero' : ''}`}>
            <div class="featured-card-meta">
              <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
              {(p.repo || p.url) && (
                <div class="card-links">
                  {p.repo && <a href={p.repo} target="_blank" rel="noopener noreferrer">repo ↗</a>}
                  {p.url && <a href={p.url} target="_blank" rel="noopener noreferrer">live ↗</a>}
                </div>
              )}
            </div>
            <div class="featured-card-body">
              <h3>{p.title}</h3>
              <p class="card-desc">{p.description}</p>
            </div>
            <ul class="tags">
              {p.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
    )}

    <!-- other projects: compact list -->
    {rest.length > 0 && (
      <>
        <p class="other-label">Otros proyectos</p>
        <ul class="other-list">
          {rest.map((p) => (
            <li class="other-item">
              <div class="other-left">
                <span class="other-title">{p.title}</span>
                <span class="other-desc">{p.description}</span>
              </div>
              <ul class="tags tags--inline">
                {p.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <div class="card-links card-links--other">
                {p.repo && <a href={p.repo} target="_blank" rel="noopener noreferrer">↗</a>}
                {p.url && <a href={p.url} target="_blank" rel="noopener noreferrer">⬡</a>}
              </div>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>

<style>
  .section-header {
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* featured */
  .featured-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  .featured-card--hero {
    grid-column: 1 / -1;
  }

  .featured-card {
    background: var(--color-surface);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: background var(--transition);
    border-bottom: 1px solid var(--color-border);
  }

  .featured-card:last-child {
    border-bottom: none;
  }

  .featured-card--hero {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 2rem;
  }

  .featured-card--hero .featured-card-meta {
    flex-direction: column;
    gap: 1rem;
  }

  .featured-card--hero .featured-card-body h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    margin-bottom: 0.75rem;
  }

  .featured-card:hover {
    background: var(--color-surface-2);
  }

  .featured-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-index {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted-2);
    letter-spacing: 0.1em;
  }

  .card-links {
    display: flex;
    gap: 1rem;
  }

  .card-links a {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.05em;
    transition: color var(--transition);
  }

  .card-links a:hover {
    color: var(--color-accent);
  }

  .featured-card-body h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border-2);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .tags--inline li {
    color: var(--color-muted-2);
    border-color: var(--color-border);
  }

  /* other projects */
  .other-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted-2);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .other-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .other-item {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 2rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition);
  }

  .other-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .other-title {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .other-desc {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .card-links--other {
    font-size: 1rem;
    gap: 0.75rem;
  }

  @media (max-width: 720px) {
    .featured-card--hero {
      grid-template-columns: 1fr;
    }

    .featured-list {
      grid-template-columns: 1fr;
    }

    .other-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
